# Environment / Secrets
# Africa's Talking, and anything else with a credential in it. These never
# reach the repo: the app reads them via --dart-define at build time.
.env
*.env
.env.*
!.env.example
secrets.json
*.key
*.pem
*.p12
*.jks
*.keystore

# Firebase / Google service credentials
google-services.json
GoogleService-Info.plist
*service-account*.json
firebase-debug.log
.firebase/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build output and deploy caches
android/build/
.wrangler/

# Source archives dropped in during design iterations
lib/features/landing/*.zip

# Generated by tool/build_static_pages.py — rebuild rather than hand-edit
web/sitemap.xml
