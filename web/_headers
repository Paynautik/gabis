# Cloudflare Pages response headers.
#
# Only the optimised pictures used by /landing/minimal are listed. Their file
# names are unique (min-*), so a browser can keep them for a year without ever
# serving a stale one: a changed picture gets a new name. Everything else keeps
# Pages' default (revalidate on each load).
/landing/media/min-*
  Cache-Control: public, max-age=31536000, immutable

# The optimised pictures on the main landing page, same idea: unique names.
/landing/media/lp-*
  Cache-Control: public, max-age=31536000, immutable

# Owner-only pages: keep out of search results and never cache.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Flutter engine files only change when the Flutter version does, so the
# browser can keep them instead of re-checking the 7 MB wasm on every visit.
/canvaskit/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/assets/packages/*
  Cache-Control: public, max-age=2592000
