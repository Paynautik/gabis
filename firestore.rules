rules_version = '2';

// gabis stores everything user-scoped under users/{uid}. Nobody reads or
// writes another person's financial data, and there is no public collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The reminder log the scheduled chaser writes is the record the
    // frequency limits are counted from, and a dispute is settled by it. The
    // owner may read their own; nobody may edit one after the fact. The
    // chaser itself writes with a service account, which these rules do not
    // apply to.
    match /users/{uid}/gabis/collections/attempts/{attempt} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // The map from a per-invoice account number to the invoice it belongs to.
    // The worker writes and reads these with a service account; a business may
    // read its own rows and nothing else, and nobody may edit one, because an
    // edited row would send somebody else's money to the wrong ledger.
    match /payment_accounts/{account} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Payments that arrived and could not be placed. Only the worker writes
    // them; nobody reads them from the app yet, and a stranger must not.
    match /unmatched_payments/{payment} {
      allow read, write: if false;
    }
  }
}
