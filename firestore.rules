rules_version = '2';

// gabis stores everything user-scoped under users/{uid}. Nobody reads or
// writes another person's financial data, and there is no public collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
